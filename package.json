  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc && npm run build:botc:bundle",
    "build:botc:bundle": "esbuild assets/ts/blood-on-the-clocktower.ts --bundle --format=iife --target=es2020 --outfile=assets/js/blood-on-the-clocktower.js",
    "watch:botc": "tsc --watch",
    "watch:botc:bundle": "esbuild assets/ts/blood-on-the-clocktower.ts --bundle --format=iife --target=es2020 --outfile=assets/js/blood-on-the-clocktower.js --watch",
    "format": "prettier --write \"**/*.{json,css,js,ts}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
